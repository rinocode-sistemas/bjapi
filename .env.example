# Copie este arquivo para .env e preencha com os valores reais (NÃO commitar o .env)

# String de conexão do Postgres
DATABASE_URL="postgresql://usuario:senha@localhost:5432/bjstore"

# Porta em que a API vai rodar
PORT=3006

# Origem permitida pelo CORS (endereço do front em dev)
CORS_ORIGIN="http://localhost:3000"

# Segredo usado para assinar os tokens JWT (gere uma string longa e aleatória)
JWT_SECRET="troque-esta-string-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"

# Credenciais do usuário SUPER criado pelo seed (troque a senha depois do primeiro login)
SEED_SUPER_USER="super"
SEED_SUPER_PASSWORD="super123"

# Chave (base64, 32 bytes) usada para cifrar credenciais de integrações externas (ex.: beijaflor ERP)
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY="troque-por-uma-chave-base64-de-32-bytes"

# SMTP para envio de e-mails transacionais (recuperação de senha, etc.)
SMTP_HOST="smtp.exemplo.com.br"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="naoresponda@exemplo.com.br"
SMTP_PASS="troque-pela-senha-do-smtp"
SMTP_FROM="BFStore <naoresponda@exemplo.com.br>"

# URL base do front (sem barra no final) — usada para montar links em e-mails,
# como o de redefinição de senha.
FRONT_URL="http://localhost:5183"
